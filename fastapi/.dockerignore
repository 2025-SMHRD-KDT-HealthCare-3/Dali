# 1. 파이썬 캐시 및 가상환경 (가장 중요)
# 내 컴퓨터의 가상환경이나 실행 찌꺼기가 컨테이너로 들어가 충돌하는 것을 막습니다.
__pycache__
*.pyc
*.pyo
.venv
venv
.pytest_cache

# 2. 보안 및 환경 변수
.env
.env.*

# 3. 로그 파일
*.log

# 4. 시스템 및 버전 관리 파일 제외
.DS_Store
.git

# 5. 도커 설정 파일은 컨테이너(실행환경) 안에 필요 없음
Dockerfile
.dockerignore
docker-compose.yml

# ---------------------------------------------------------
# [주의] AI 모델 파일(.pt, .bin)은 실제 서버 배포 시 컨테이너 안에 
# 존재해야 하므로 ignore 목록에 넣지 않음
# ---------------------------------------------------------